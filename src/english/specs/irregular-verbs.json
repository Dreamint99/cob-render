          "amp": "0389897432222221000000007996798743006999977776567678877776433322000000000000000499659963024376542289743327411134444333005874289533314422322210121000000"
        },
        {
          "who": "A",
          "text": "I saw you there, but you didn't see me. I was buying hilsa.",
          "bn": "আমি তোমাকে সেখানে দেকেছিলাম, কিন্তু তুমি আমাকে দেখো নি। আমিও তখান ইলিশ কিনছিলাম।",
          "file": "lines/s03_3.mp3",
          "frames": 130,
          "amp": "0799543346788967962485444566630000038876202245531672564332376888888976532000000000000000999597320864566565356754222595421000000"
